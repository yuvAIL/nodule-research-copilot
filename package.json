{
  "name": "nodule-research-copilot",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based research prototype CT viewer (Milestone 1: local DICOM CT viewing). Not for clinical use.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && vite build",
    "diagnose:builtins": "node scripts/find-node-builtins.mjs",
    "dev:clean": "vite --force",
    "prepare:sample": "node scripts/prepare-sample.mjs"
  },
  "dependencies": {
    "@cornerstonejs/core": "5.13.1",
    "@cornerstonejs/dicom-image-loader": "5.13.1",
    "@cornerstonejs/metadata": "5.13.1",
    "@cornerstonejs/tools": "5.13.1",
    "dicom-parser": "^1.8.21",
    "events": "^3.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
