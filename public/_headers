# Cloudflare Pages response headers.
# The Content-Security-Policy is the technical privacy guarantee: the page may only
# talk to its own origin ('self'), so a researcher's local DICOM files cannot be
# sent anywhere else, even by a bug or a third-party library.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' blob: data:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/sample/*
  Cache-Control: public, max-age=604800
