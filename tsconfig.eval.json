{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".eval-build",
    "rootDir": "src",
    "declaration": false,
    "noEmit": false
  },
  "include": [
    "src/reference/*.ts",
    "src/measure/*.ts",
    "src/ai/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
